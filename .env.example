# LLM API Keys — obtain from each provider's developer console
# At least one must be set for reviews to work.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# LLM Model names — override these to use different models
# Leave blank to use the defaults below
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GEMINI_MODEL=gemini-3.5-flash

# Repository ingestion limits (tune to control API usage and cost)
DEFAULT_BRANCH=main
MAX_FILES=30
MAX_FILE_BYTES=20000

# CORS — set to wherever the React frontend runs
FRONTEND_ORIGIN=http://localhost:5173

# Storage paths (relative to project root)
REPORTS_DIR=reports
TEMP_DIR=.tmp
